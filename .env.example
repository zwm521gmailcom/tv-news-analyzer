# ── MiniMax AI ─────────────────────────────────────────────
# MiniMax API（用于 AI 叙事生成，替代 Ollama）
# API Key 从 https://platform.minimax.chat 获取
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# ── 语言 ───────────────────────────────────────────────────
# 并发抓取语言列表（同时获取中英文；留空则使用 TV_FILTER_LANG）
TV_FETCH_LANGS=en,zh-Hans

# 向后兼容单语言模式
TV_FILTER_LANG=en

# ── 交易对（逗号分隔，留空=不按交易对筛选）────────────────
TV_FILTER_SYMBOLS=

# ── 市场类型（商品/市场，可多选，留空=不限）───────────────
# 可选值：crypto  stock  forex  futures  bond  etf  index  economic  corp_bond
# 默认排除 stock，保留其他市场
TV_FILTER_MARKETS=bond,corp_bond,crypto,economic,etf,forex,futures,index

# ── 企业活动（可多选，留空=不过滤）───────────────────────
# 可选值：earnings  earnings_calls  ipo  dividends  mergers_and_acquisitions
#         management  recommendation  share_buybacks  insider_trading
#         esg  strategy_business_products
TV_FILTER_CORP_ACTIVITIES=

# ── 宏观经济分类（可多选，留空=不过滤）───────────────────
# 可选值：business  consumer  gdp  government  health  housing
#         labor  money  prices  taxes  trade
TV_FILTER_ECONOMIC_CATEGORIES=

# ── 提供商白名单（可多选，留空=不限）─────────────────────
# 可选值：reuters  tradingview  beincrypto  barchart  dow  zacks
#         globenewswire  marketbeat  sharecast  stockstory 等
TV_FILTER_PROVIDERS=

# ── 新闻正文 ──────────────────────────────────────────────
FETCH_STORY_BODY=false

# ── TradingView Cookie ─────────────────────────────────────
# 手动输入 Cookie 的唯一入口是 data/cookies.txt
# - 文件有内容：会解析并同步生成 data/cookies.json
# - 文件为空：匿名运行
# data/cookies.json 是自动生成的缓存文件

# ── 实时价格 WebSocket（可选）──────────────────────────────
# 需要 `data/cookies.txt` 中的 Cookie 才能获取 JWT
ENABLE_PRICE_TRACKER=false
TV_PRICE_SYMBOLS=BINANCE:BTCUSDT,BINANCE:ETHUSDT,BINANCE:SOLUSDT,BINANCE:BNBUSDT,BINANCE:XRPUSDT

# ── 代理 ───────────────────────────────────────────────────
HTTP_PROXY=http://127.0.0.1:7890
ALL_PROXY=http://127.0.0.1:7890
